# Application
APP_ENV=development
APP_API_TOKEN=replace-with-a-long-random-secret
APP_ADMIN_TOKEN=replace-with-a-different-long-random-admin-secret
DATABASE_URL=postgresql+psycopg://treasurypilot:treasurypilot@localhost:5432/treasurypilot
FRONTEND_ORIGINS=http://localhost:5173

# Airwallex sandbox credentials (backend only)
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Optional target account ID for scoped keys linked to multiple accounts.
AIRWALLEX_LOGIN_AS=

# Optional LLM provider. Core policy decisions do not depend on this.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
